# OpenWeather API Configuration
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Supabase Cloud Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-side only: never expose this in frontend/React
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Primary Supabase PostgreSQL Database Configuration (IPv4 Connection Pooler)
# Note: Render and other cloud hosts lack IPv6 outbound, so always use the Pooler URL
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
PGHOST=aws-0-[region].pooler.supabase.com
PGPORT=5432
PGUSER=postgres.[project-ref]
PGPASSWORD=your_password_here
PGDATABASE=postgres
PGSSLMODE=require

# Device Offline Timeout (seconds)
DEVICE_OFFLINE_TIMEOUT_SECONDS=300

# Supabase Storage Configuration (Private Bucket)
POULTRY_IMAGES_BUCKET=poultry-images
